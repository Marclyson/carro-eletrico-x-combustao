        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "PASSO 4 DE 4",
                    "textStyle": {
                      "fontSize": "8pt",
                      "fontWeight": "bold",
                      "color": "#C8C6C4"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Etanol ou gasolina?",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontWeight": "bold",
                      "color": "#F2C811"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "O QUE MOSTRA",
                    "textStyle": {
                      "fontSize": "8pt",
                      "fontWeight": "bold",
                      "color": "#F2C811"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "O preço do litro de etanol dividido pelo da gasolina.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "COMO LER",
                    "textStyle": {
                      "fontSize": "8pt",
                      "fontWeight": "bold",
                      "color": "#F2C811"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Abaixo da linha amarela, o etanol rende mais por real neste carro. A linha cinza é a regra dos 70 % usada nos postos.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "LÓGICA",
                    "textStyle": {
                      "fontSize": "8pt",
                      "fontWeight": "bold",
                      "color": "#F2C811"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "A linha amarela é o km/l com etanol dividido pelo km/l com gasolina do carro escolhido. No Kwid: 10,5 ÷ 14,9 = 70,5 %.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "MEDIDAS",
                    "textStyle": {
                      "fontSize": "8pt",
                      "fontWeight": "bold",
                      "color": "#F2C811"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "[Razão de preço etanol/gasolina] e [Razão de rendimento do carro].",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "ATENÇÃO",
                    "textStyle": {
                      "fontSize": "8pt",
                      "fontWeight": "bold",
                      "color": "#F2C811"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Usa o preço com tributos e nominal; a razão não muda com o IPCA.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              }
            ]
          }
        }
