                      "fontSize": "8pt",
                      "fontWeight": "bold",
                      "color": "#F2C811"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "[Custo elétrico 12m], [Economia 12m] e [ICMS efetivo 12m].",
