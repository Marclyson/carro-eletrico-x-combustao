    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "PASSO 1 DE 4",
                    "textStyle": {
                      "fontSize": "8pt",
                      "fontWeight": "bold",
                      "color": "#C8C6C4"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Gasolina em parcelas",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontWeight": "bold",
                      "color": "#F2C811"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "O QUE MOSTRA",
                    "textStyle": {
                      "fontSize": "8pt",
                      "fontWeight": "bold",
                      "color": "#F2C811"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "O custo de 100 km a gasolina separado em preço sem tributos, ICMS, PIS/Cofins e CIDE.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "COMO LER",
                    "textStyle": {
                      "fontSize": "8pt",
                      "fontWeight": "bold",
                      "color": "#F2C811"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "O ICMS em amarelo aparece em jun./2023, quando passa a ser um valor por litro. Antes disso ele está dentro da faixa clara de cima. A dica mostra o total e a parte de cada tributo no mês.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "LÓGICA",
                    "textStyle": {
                      "fontSize": "8pt",
                      "fontWeight": "bold",
                      "color": "#F2C811"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "PIS/Cofins e CIDE por litro de gasolina A, vezes a parte de gasolina A na gasolina C. Vale a regra em vigor no dia 15 de cada mês.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "MEDIDAS",
                    "textStyle": {
                      "fontSize": "8pt",
                      "fontWeight": "bold",
                      "color": "#F2C811"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "[Gasolina: sem tributos], [Gasolina: sem federais, ICMS dentro], [Gasolina: ICMS], [Gasolina: PIS/Cofins] e [Gasolina: CIDE].",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "ATENÇÃO",
                    "textStyle": {
                      "fontSize": "8pt",
                      "fontWeight": "bold",
                      "color": "#F2C811"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "De jul. a dez./2022 a LC 194 zerou PIS/Cofins e CIDE.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              }
            ]
          }
        }
