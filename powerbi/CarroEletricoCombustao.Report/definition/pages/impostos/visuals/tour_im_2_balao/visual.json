                      "fontWeight": "bold",
                      "color": "#F2C811"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "A faixa clara sobe com as bandeiras de 2021 e 2022. O ICMS em amarelo cai a partir de jul./2022.",
