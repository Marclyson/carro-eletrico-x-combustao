                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "COMO LER",
                    "textStyle": {
                      "fontSize": "8pt",
                      "fontWeight": "bold",
                      "color": "#F2C811"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Sem escolha, valem 12.000 km por ano, 80 % em casa na tarifa convencional, carregador a R$ 2,00/kWh e 10 anos.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "LÓGICA",
                    "textStyle": {
                      "fontSize": "8pt",
                      "fontWeight": "bold",
                      "color": "#F2C811"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Energia e gasolina com o preço médio real dos últimos 12 meses da UF, com tributos.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "MEDIDAS",
                    "textStyle": {
                      "fontSize": "8pt",
                      "fontWeight": "bold",
                      "color": "#F2C811"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "[Km por ano escolhido], [Recarga em casa escolhida], [Tarifa em casa escolhida], [Carregador escolhido] e [Anos de uso escolhidos].",
                    "textStyle": {
                      "fontSize": "10pt",
