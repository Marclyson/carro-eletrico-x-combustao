                      "fontWeight": "bold",
                      "color": "#F2C811"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Estado, par de carros, km por ano, quanto recarrega em casa, tarifa de casa, carregador público e anos de uso.",
