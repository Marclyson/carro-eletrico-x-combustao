model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["PastaGold","PastaReferencias","Calendário", "Estados", "Veículos", "Energias", "Custo por km", "Preço da energia", "Carros", "Comparação", "Valores", "Tributos", "Métrica do mapa", "Tarifa em casa", "Km por ano", "Recarga em casa (%)", "Carregador público", "Anos de uso", "Preço do carro a combustão (R$)", "Preço do carro elétrico (R$)", "Ano de uso", "_Medidas"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'Calendário'
ref table Estados
ref table 'Veículos'
ref table Energias
ref table 'Custo por km'
ref table 'Preço da energia'
ref table Carros
ref table 'Comparação'
ref table Valores
ref table Tributos
ref table 'Métrica do mapa'
ref table 'Tarifa em casa'
ref table 'Km por ano'
ref table 'Recarga em casa (%)'
ref table 'Carregador público'
ref table 'Anos de uso'
ref table 'Preço do carro a combustão (R$)'
ref table 'Preço do carro elétrico (R$)'
ref table 'Ano de uso'
ref table _Medidas

